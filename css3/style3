/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Color Palette */
:root {
    --purple: #4B0082;
    --light-purple: #9370DB;
    --background: #F5F5F5;
    --white: #FFFFFF;
    --text: #333333;
    --border: #D9D9D9;
}

/* Base Styles */
body {
    font-family: 'Poppins', Arial, sans-serif;
    background-color: var(--background);
    color: var(--text);
    line-height: 1.6;
}

/* Type Selectors */
h1,
h2,
h3 {
    font-family: 'Lora', Georgia, serif;
    margin-bottom: 16px;
}

p {
    margin-bottom: 8px;
}

ul,
ol {
    padding-left: 24px;
}

/* Header */
header {
    background-color: var(--purple);
    color: var(--white);
    text-align: center;
    padding: 32px 16px;
}

header h1 {
    font-size: 40px;
}

/* Navigation */
nav {
    background-color: var(--light-purple);
    padding: 16px;
}

nav ul {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    list-style: none;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: 600;
}

nav a:hover {
    text-decoration: underline;
}

/* Flexbox Layout */
.container {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    max-width: 1200px;
    margin: 32px auto;
    padding: 0 24px;
}

/* Card Layout */
.card {
    flex: 1 1 300px;
    background-color: var(--white);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 24px;
}

/* ID Selectors */
#about,
#family,
#goals {
    scroll-margin-top: 80px;
}

/* Article Styling */
article {
    padding: 16px;
    background-color: #fafafa;
    border-radius: 8px;
}

/* Footer */
footer {
    background-color: var(--purple);
    color: white;
    text-align: center;
    padding: 24px;
    margin-top: 32px;
}


/* =========================
   Tablet View - 768px
   ========================= */

@media screen and (max-width: 768px) {

    .container {
        flex-direction: column;
        padding: 16px;
    }

    nav ul {
        justify-content: space-around;
    }

    header h1 {
        font-size: 32px;
    }

    .card {
        width: 100%;
    }
}


/* =========================
   Mobile View - 320px
   ========================= */

@media screen and (max-width: 320px) {

    header {
        padding: 24px 8px;
    }

    header h1 {
        font-size: 24px;
    }

    nav ul {
        flex-direction: column;
        gap: 12px;
    }

    .container {
        padding: 8px;
        margin: 16px auto;
    }

    .card {
        padding: 16px;
    }

    h2 {
        font-size: 20px;
    }

    p,
    li {
        font-size: 14px;
    }
}


/* =========================
   Desktop View - 1200px+
   ========================= */

@media screen and (min-width: 1200px) {

    .container {
        justify-content: space-between;
    }

    .card {
        max-width: 360px;
    }
}
